                  "key": "idType",
                  "value": "<string>",
                  "description": "Type of the provided identifier"
                },
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of additional fields to include"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language code for localized metadata (ISO 639-1)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "contentId",
                  "description": "(Required) Content identifier (Rovi, TMDB, or EIDR format)"
